import os
import cv2
import numpy as np
import tkinter as tk
from tkinter import filedialog
from PIL import Image, ImageTk
from sklearn.svm import SVC

dataset_path = r"E:\ML Projects\tasik3\train"
img_size = 64

X = []
y = []

for label, category in enumerate(["cats", "dogs"]):
    folder = os.path.join(dataset_path, category)

    for file in os.listdir(folder):
        path = os.path.join(folder, file)
        image = cv2.imread(path)

        if image is None:
            continue

        image = cv2.resize(image, (img_size, img_size))
        image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
        image = image.flatten() / 255.0

        X.append(image)
        y.append(label)

X = np.array(X)
y = np.array(y)

model = SVC(kernel="rbf", C=10, probability=True)
model.fit(X, y)

selected_image = None


def upload_image():
    global selected_image

    selected_image = filedialog.askopenfilename(
        filetypes=[
            ("Image Files", "*.jpg *.jpeg *.png")
        ]
    )

    if selected_image:
        image = Image.open(selected_image)
        image.thumbnail((350, 300))

        photo = ImageTk.PhotoImage(image)

        image_label.config(image=photo, text="")
        image_label.image = photo

        result_label.config(text="Result: -")


def predict():
    if selected_image is None:
        result_label.config(text="Please select an image")
        return

    image = cv2.imread(selected_image)

    image = cv2.resize(image, (img_size, img_size))
    image = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)
    image = image.flatten() / 255.0

    prediction = model.predict([image])[0]

    if prediction == 0:
        result = "Cat 🐱"
    else:
        result = "Dog 🐶"

    result_label.config(text="Result: " + result)


window = tk.Tk()
window.title("Cat and Dog Classifier")
window.geometry("550x550")
window.resizable(False, False)

title = tk.Label(
    window,
    text="Cat and Dog Image Classifier",
    font=("Arial", 20, "bold")
)

title.pack(pady=20)

info = tk.Label(
    window,
    text="SVM Image Classification",
    font=("Arial", 11)
)

info.pack()

image_label = tk.Label(
    window,
    text="No Image Selected",
    width=40,
    height=15,
    relief="solid"
)

image_label.pack(pady=20)

upload_button = tk.Button(
    window,
    text="Upload Image",
    command=upload_image,
    width=20
)

upload_button.pack(pady=5)

predict_button = tk.Button(
    window,
    text="Predict",
    command=predict,
    width=20
)

predict_button.pack(pady=5)

result_label = tk.Label(
    window,
    text="Result: -",
    font=("Arial", 18, "bold")
)

result_label.pack(pady=25)

window.mainloop()
